{
  "name": "@wuapidev/cli",
  "version": "0.11.0",
  "description": "The wuapi command line: log in from the browser, link a WhatsApp number through a link the person opens (QR or pairing code), run your app with the key, send messages, set up the MCP server and call every endpoint of the wuapi API from your terminal or your agent.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "wuapi": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "wuapi",
    "whatsapp",
    "whatsapp-api",
    "cli",
    "ai-agents",
    "mcp"
  ],
  "homepage": "https://wuapi.dev/docs#cli",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wuapidev/wuapi-cli.git"
  },
  "bugs": {
    "url": "https://github.com/wuapidev/wuapi-cli/issues"
  },
  "scripts": {
    "gen": "node scripts/gen-operations.mjs",
    "build": "rm -rf dist && tsc -p tsconfig.build.json && chmod +x dist/cli.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "@wuapidev/sdk": "^0.13.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.6.0",
    "vitest": "^4.0.14"
  },
  "publishConfig": {
    "access": "public"
  }
}
